---
import StepIndicator from '@features/registration/components/StepIndicator.astro';
import PersonalInfo from '@features/registration/components/PersonalInfo.astro';
import RaceInfo from '@features/registration/components/RaceInfo.astro';
import RegistrationSummary from '@features/registration/components/RegistrationSummary.astro';

interface Props {
  eventId: string;
  eventName: string;
  distances: { id: string; name: string; kilometers: number; price?: number }[];
}
const { eventId, eventName, distances } = Astro.props;
const steps = ['Datos personales', 'Datos de carrera', 'Confirmar'];
---
<section class="mx-auto max-w-2xl px-4 py-10">
  <header class="mb-6">
    <p class="text-sm text-slate-500">Inscripción a</p>
    <h1 class="text-2xl font-bold text-slate-900">{eventName}</h1>
  </header>

  <StepIndicator steps={steps} current={0} />

  <form id="register-form" data-event-id={eventId} class="rounded-xl bg-white p-6 shadow-sm" novalidate>
    <div data-panel="0"><PersonalInfo /></div>
    <div data-panel="1" class="hidden"><RaceInfo eventId={eventId} distances={distances} /></div>
    <div data-panel="2" class="hidden"><RegistrationSummary data={{}} /></div>

    <div class="mt-6 flex items-center justify-between border-t border-slate-200 pt-4">
      <button type="button" data-action="prev" class="hidden rounded border border-slate-300 px-4 py-2 text-sm font-medium text-slate-700 hover:bg-slate-50">
        Atrás
      </button>
      <div class="ml-auto flex gap-2">
        <button type="button" data-action="next" class="rounded bg-blue-600 px-4 py-2 text-sm font-semibold text-white hover:bg-blue-700">
          Siguiente
        </button>
        <button type="submit" data-action="submit" class="hidden rounded bg-green-600 px-4 py-2 text-sm font-semibold text-white hover:bg-green-700">
          Confirmar inscripción
        </button>
      </div>
    </div>

    <div id="form-error" role="alert" class="mt-3 hidden rounded bg-red-50 p-3 text-sm text-red-700"></div>
  </form>
</section>

<script>
  import { actions } from 'astro:actions';
  import { submitRegistration, eventSlugFromPath } from '@features/registration/lib/submit-registration';

  const form = document.getElementById('register-form') as HTMLFormElement | null;
  if (form) {
    let current = 0;
    const panels = form.querySelectorAll<HTMLElement>('[data-panel]');
    const prevBtn = form.querySelector<HTMLButtonElement>('[data-action="prev"]');
    const nextBtn = form.querySelector<HTMLButtonElement>('[data-action="next"]');
    const submitBtn = form.querySelector<HTMLButtonElement>('[data-action="submit"]');
    const errBox = form.querySelector<HTMLElement>('#form-error');

    const show = (i: number) => {
      panels.forEach((p, idx) => p.classList.toggle('hidden', idx !== i));
      prevBtn?.classList.toggle('hidden', i === 0);
      nextBtn?.classList.toggle('hidden', i === panels.length - 1);
      submitBtn?.classList.toggle('hidden', i !== panels.length - 1);
      if (errBox) errBox.classList.add('hidden');
    };
    show(0);

    nextBtn?.addEventListener('click', () => {
      // collect values from current panel
      const currentPanel = panels[current];
      const inputs = currentPanel.querySelectorAll<HTMLInputElement | HTMLSelectElement>('input, select');
      for (const el of Array.from(inputs)) {
        if (!el.checkValidity()) {
          el.reportValidity();
          return;
        }
      }
      if (current < panels.length - 1) {
        current++;
        // sync summary
        if (current === 2) {
          const data: Record<string, string> = {};
          form.querySelectorAll<HTMLInputElement | HTMLSelectElement>('input, select').forEach((el) => {
            if (el.name && el.value) data[el.name] = el.value;
          });
          const summary = panels[2];
          summary.innerHTML = '';
          const labelMap: Record<string, string> = {
            first_name: 'Nombre', last_name: 'Apellido paterno', second_last_name: 'Apellido materno',
            birth_date: 'Fecha de nacimiento', gender: 'Género', phone: 'Teléfono', email: 'Email',
            distance_id: 'Distancia', emergency_contact_name: 'Contacto emergencia (nombre)',
            emergency_contact_phone: 'Contacto emergencia (teléfono)',
            t_shirt_size: 'Talla de playera', medical_conditions: 'Condiciones médicas',
          };
          const dl = document.createElement('dl');
          dl.className = 'divide-y divide-slate-200 rounded-lg border border-slate-200 bg-white';
          for (const [key, label] of Object.entries(labelMap)) {
            const val = data[key];
            if (!val) continue;
            const row = document.createElement('div');
            row.className = 'flex justify-between px-4 py-3 text-sm';
            row.innerHTML = `<dt class="font-medium text-slate-600">${label}</dt><dd class="text-slate-900">${val}</dd>`;
            dl.appendChild(row);
          }
          const heading = document.createElement('h2');
          heading.className = 'text-lg font-semibold text-slate-900 mb-3';
          heading.textContent = 'Confirma tu inscripción';
          const note = document.createElement('p');
          note.className = 'text-xs text-slate-500 mt-3';
          note.textContent = 'Al enviar, aceptas el reglamento del evento. Te enviaremos un correo de confirmación.';
          summary.appendChild(heading);
          summary.appendChild(dl);
          summary.appendChild(note);
        }
        show(current);
      }
    });

    prevBtn?.addEventListener('click', () => {
      if (current > 0) { current--; show(current); }
    });

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      const fd = new FormData(form);
      const payload = Object.fromEntries(fd.entries()) as Record<string, string>;
      const slug = eventSlugFromPath(window.location.pathname) ?? '';
      const outcome = await submitRegistration(
        (input) => actions.registration.submit(input as any),
        payload,
        slug,
      ).catch(() => ({ ok: false as const, message: '' }));
      if (outcome.ok) {
        window.location.href = outcome.redirectTo;
      } else if (errBox) {
        errBox.textContent = outcome.message || 'No se pudo completar la inscripción. Intenta de nuevo.';
        errBox.classList.remove('hidden');
      }
    });
  }
</script>
