---
interface Props { errors?: Record<string, string> }
const { errors = {} } = Astro.props;
const e = (k: string) => errors[k] ?? '';
---
<fieldset class="space-y-4" data-step="personal">
  <legend class="sr-only">Datos personales</legend>
  <div class="grid gap-4 sm:grid-cols-3">
    <label class="block">
      <span class="text-sm font-medium text-slate-700">Nombre</span>
      <input name="first_name" required class="mt-1 w-full rounded border border-slate-300 px-3 py-2" />
      {e('first_name') && <span class="text-xs text-red-600">{e('first_name')}</span>}
    </label>
    <label class="block">
      <span class="text-sm font-medium text-slate-700">Apellido paterno</span>
      <input name="last_name" required class="mt-1 w-full rounded border border-slate-300 px-3 py-2" />
      {e('last_name') && <span class="text-xs text-red-600">{e('last_name')}</span>}
    </label>
    <label class="block">
      <span class="text-sm font-medium text-slate-700">Apellido materno</span>
      <input name="second_last_name" required class="mt-1 w-full rounded border border-slate-300 px-3 py-2" />
      {e('second_last_name') && <span class="text-xs text-red-600">{e('second_last_name')}</span>}
    </label>
  </div>

  <div class="grid gap-4 sm:grid-cols-2">
    <label class="block">
      <span class="text-sm font-medium text-slate-700">Fecha de nacimiento</span>
      <input name="birth_date" type="date" required class="mt-1 w-full rounded border border-slate-300 px-3 py-2" />
      {e('birth_date') && <span class="text-xs text-red-600">{e('birth_date')}</span>}
    </label>
    <label class="block">
      <span class="text-sm font-medium text-slate-700">Género</span>
      <select name="gender" required class="mt-1 w-full rounded border border-slate-300 px-3 py-2">
        <option value="">Selecciona...</option>
        <option value="male">Masculino</option>
        <option value="female">Femenino</option>
        <option value="other">Otro</option>
        <option value="prefer_not_to_say">Prefiero no decir</option>
      </select>
      {e('gender') && <span class="text-xs text-red-600">{e('gender')}</span>}
    </label>
  </div>

  <div class="grid gap-4 sm:grid-cols-2">
    <label class="block">
      <span class="text-sm font-medium text-slate-700">Teléfono</span>
      <input name="phone" type="tel" required class="mt-1 w-full rounded border border-slate-300 px-3 py-2" />
      {e('phone') && <span class="text-xs text-red-600">{e('phone')}</span>}
    </label>
    <label class="block">
      <span class="text-sm font-medium text-slate-700">Email</span>
      <input name="email" type="email" required class="mt-1 w-full rounded border border-slate-300 px-3 py-2" />
      {e('email') && <span class="text-xs text-red-600">{e('email')}</span>}
    </label>
  </div>
</fieldset>
