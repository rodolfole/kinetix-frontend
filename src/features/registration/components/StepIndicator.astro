---
interface Props {
  steps: string[];
  current: number;
}
const { steps, current } = Astro.props;
---
<nav aria-label="Progreso del registro" class="mb-8">
  <ol class="flex items-center justify-between gap-2">
    {steps.map((label, i) => {
      const isActive = i === current;
      const isDone = i < current;
      return (
        <li class="flex flex-1 items-center">
          <div class="flex flex-col items-center text-center">
            <span
              class={`flex h-9 w-9 items-center justify-center rounded-full text-sm font-semibold ${
                isDone ? 'bg-green-500 text-white'
                : isActive ? 'bg-blue-600 text-white'
                : 'bg-slate-200 text-slate-500'
              }`}
            >
              {isDone ? '✓' : i + 1}
            </span>
            <span class={`mt-2 text-xs font-medium ${isActive ? 'text-blue-700' : 'text-slate-500'}`}>
              {label}
            </span>
          </div>
          {i < steps.length - 1 && (
            <div class={`mx-2 h-0.5 flex-1 ${isDone ? 'bg-green-500' : 'bg-slate-200'}`}></div>
          )}
        </li>
      );
    })}
  </ol>
</nav>
