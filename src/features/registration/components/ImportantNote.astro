  <div class="bg-blue-600 rounded-full p-2 text-white shrink-0">
    <AlertCircle class="w-4 h-4" />
  </div>
  <div>
    <h4 class="text-sm font-bold text-foreground mb-1">Nota Importante</h4>
    <p class="text-xs text-muted-foreground leading-relaxed">
      <slot />
    </p>
  </div>
</aside>