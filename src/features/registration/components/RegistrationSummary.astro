---
interface Props {
  data: Record<string, string>;
}
const { data } = Astro.props;
const labelMap: Record<string, string> = {
  first_name: 'Nombre',
  last_name: 'Apellido paterno',
  second_last_name: 'Apellido materno',
  birth_date: 'Fecha de nacimiento',
  gender: 'Género',
  phone: 'Teléfono',
  email: 'Email',
  distance_id: 'Distancia',
  emergency_contact_name: 'Contacto emergencia (nombre)',
  emergency_contact_phone: 'Contacto emergencia (teléfono)',
  t_shirt_size: 'Talla de playera',
  medical_conditions: 'Condiciones médicas',
};
---
<section class="space-y-4" data-step="summary">
  <h2 class="text-lg font-semibold text-slate-900">Confirma tu inscripción</h2>
  <dl class="divide-y divide-slate-200 rounded-lg border border-slate-200 bg-white">
    {Object.entries(labelMap).map(([key, label]) => {
      const val = data[key];
      if (!val) return null;
      return (
        <div class="flex justify-between px-4 py-3 text-sm">
          <dt class="font-medium text-slate-600">{label}</dt>
          <dd class="text-slate-900">{val}</dd>
        </div>
      );
    })}
  </dl>
  <p class="text-xs text-slate-500">
    Al enviar, aceptas el reglamento del evento. Te enviaremos un correo de confirmación.
  </p>
</section>
