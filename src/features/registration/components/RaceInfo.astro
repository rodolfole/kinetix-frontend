---
interface Props {
  eventId: string;
  distances: { id: string; name: string; kilometers: number; price?: number }[];
  errors?: Record<string, string>;
}
const { eventId, distances, errors = {} } = Astro.props;
const e = (k: string) => errors[k] ?? '';
---
<fieldset class="space-y-4" data-step="race">
  <legend class="sr-only">Datos de la carrera</legend>
  <input type="hidden" name="event_id" value={eventId} />

  <label class="block">
    <span class="text-sm font-medium text-slate-700">Distancia</span>
    <select name="distance_id" required class="mt-1 w-full rounded border border-slate-300 px-3 py-2">
      <option value="">Selecciona una distancia...</option>
      {distances.map((d) => (
        <option value={d.id}>{d.name} · {d.kilometers}K{d.price !== undefined ? ` · $${d.price}` : ''}</option>
      ))}
    </select>
    {e('distance_id') && <span class="text-xs text-red-600">{e('distance_id')}</span>}
  </label>

  <div class="grid gap-4 sm:grid-cols-2">
    <label class="block">
      <span class="text-sm font-medium text-slate-700">Contacto de emergencia (nombre)</span>
      <input name="emergency_contact_name" class="mt-1 w-full rounded border border-slate-300 px-3 py-2" />
    </label>
    <label class="block">
      <span class="text-sm font-medium text-slate-700">Contacto de emergencia (teléfono)</span>
      <input name="emergency_contact_phone" type="tel" class="mt-1 w-full rounded border border-slate-300 px-3 py-2" />
    </label>
  </div>

  <div class="grid gap-4 sm:grid-cols-2">
    <label class="block">
      <span class="text-sm font-medium text-slate-700">Talla de playera</span>
      <select name="t_shirt_size" class="mt-1 w-full rounded border border-slate-300 px-3 py-2">
        <option value="">Opcional</option>
        <option value="XS">XS</option>
        <option value="S">S</option>
        <option value="M">M</option>
        <option value="L">L</option>
        <option value="XL">XL</option>
      </select>
    </label>
    <label class="block">
      <span class="text-sm font-medium text-slate-700">Condiciones médicas</span>
      <input name="medical_conditions" class="mt-1 w-full rounded border border-slate-300 px-3 py-2" />
    </label>
  </div>
</fieldset>
