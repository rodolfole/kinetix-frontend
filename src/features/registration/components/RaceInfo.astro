---
import { Button, Heading } from '@shared/components';
import { Input } from '@/components/starwind/input';
import { Label } from '@/components/starwind/label';
import { Select, SelectTrigger, SelectContent, SelectItem, SelectValue } from '@/components/starwind/select';
import { RadioGroup, RadioGroupItem } from '@/components/starwind/radio-group';

const distances = [
  { id: '5k', name: '5K', desc: 'RECREATIVA', price: '$250' },
  { id: '10k', name: '10K', desc: 'COMPETITIVA', price: '$450' },
  { id: '21k', name: '21K', desc: 'MEDIA MARATÓN', price: '$650' },
  { id: '42k', name: '42K', desc: 'MARATÓN', price: '$850' },
];

const categories = [
  { value: '', label: 'Seleccionar rango...' },
  { value: '18-29', label: '18-29 años' },
  { value: '30-39', label: '30-39 años' },
  { value: '40-49', label: '40-49 años' },
  { value: '50-59', label: '50-59 años' },
  { value: '60+', label: '60+ años' },
];

const sizes = ['XS', 'S', 'M', 'L', 'XL', 'XXL'];
---

<div id="step-2" class="hidden space-y-8">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12">
    <div class="lg:col-span-8">
        <div class="mb-10">
        <Heading as="h1" class="!text-5xl md:text-6xl font-black italic uppercase tracking-tighter mb-4 leading-none">Paso 2: Información de la Carrera</Heading>
        <p class="text-zinc-500 text-lg">Personaliza tu experiencia y asegura que todo esté listo para el día del evento.</p>
        </div>

        <div class="bg-white rounded-2xl p-8 md:p-10 shadow-sm border border-zinc-100 space-y-8">
        <!-- Distance Selection -->
        <div>
            <Label class="!text-blue-800 !font-black !text-xs mb-6 uppercase tracking-widest block">Selecciona tu Distancia</Label>
            <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
            {distances.map((d) => (
                <div class="relative">
                <RadioGroup name="distance" value={d.id} class="contents">
                    <RadioGroupItem
                    value={d.id}
                    id={`distance-${d.id}`}
                    class="peer absolute inset-0 opacity-0 cursor-pointer z-10"
                    />
                    <label
                    for={`distance-${d.id}`}
                    class="w-full p-6 bg-zinc-100 border-2 border-transparent rounded-xl transition-all text-center group cursor-pointer block hover:border-blue-300 peer-checked:border-blue-600 peer-checked:bg-blue-50 peer-checked:shadow-md peer-checked:shadow-blue-500/20"
                    >
                    <div class="text-3xl font-black font-headline mb-1 group-hover:scale-105 transition-transform peer-checked:text-blue-700">{d.name}</div>
                    <div class="text-[10px] font-black text-zinc-400 tracking-widest mb-2">{d.desc}</div>
                    <div class="text-lg font-black text-blue-700">{d.price} MXN</div>
                    </label>
                </RadioGroup>
                </div>
            ))}
            </div>
        </div>

        <!-- Category and Time -->
        <div class="grid grid-cols-1 md:grid-cols-2 gap-6 pt-6 border-t border-zinc-100">
            <div class="space-y-2">
            <Label for="categoria">Categoría por Edad</Label>
            <Select name="categoria" id="categoria" required>
                <SelectTrigger class="bg-zinc-100 w-full">
                <SelectValue placeholder="Selecciona categoria" />
                </SelectTrigger>
                <SelectContent>
                {categories.map(option => (
                    <SelectItem value={option.value}>{option.label}</SelectItem>
                ))}
                </SelectContent>
            </Select>
            </div>

            <div class="space-y-2">
            <Label for="tiempo">Tiempo Estimado (HH:MM)</Label>
            <Input id="tiempo" name="tiempo" placeholder="00:45" class="bg-zinc-100 border-none" />
            </div>
        </div>

        <!-- Team and Shirt Size -->
        <div class="grid grid-cols-1 md:grid-cols-2 gap-6 pt-6 border-t border-zinc-100">
            <div class="space-y-2">
            <Label for="equipo">Equipo / Club</Label>
            <Input id="equipo" name="equipo" placeholder="Nombre de tu equipo (opcional)" class="bg-zinc-100 border-none" />
            </div>

            <div>
            <Label for='talla' class="!text-blue-800 !font-black !text-xs mb-4 uppercase tracking-widest block">Talla de Playera</Label>
            <div class="flex gap-3 flex-wrap">
                {sizes.map((s) => (
                <div class="relative">
                    <RadioGroup name="talla" value={s}>
                    <RadioGroupItem
                        value={s}
                        id={`size-${s}`}
                        class="peer absolute inset-0 opacity-0 cursor-pointer z-10"
                    />
                    <label
                    for={`size-${s}`}
                    class="w-14 h-14 flex items-center justify-center bg-zinc-100 rounded-lg font-black transition-all cursor-pointer hover:bg-zinc-200 peer-checked:bg-blue-600 peer-checked:text-white peer-checked:shadow-md peer-checked:shadow-blue-500/30"
                    >
                    {s}
                    </label>
                </RadioGroup>
                </div>
                ))}
            </div>
            </div>
        </div>
        </div>

        <!-- Submit Button -->
        <div class="pt-8">
        <Button
            type="submit"
            variant="tertiary"
            size="lg"
            class="w-full !py-6 !text-2xl font-black italic shadow-blue-500/40"
        >
            FINALIZAR REGISTRO Y PAGAR
            <svg slot="after" class="w-6 h-6 ml-2" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="3">
            <path stroke-linecap="round" stroke-linejoin="round" d="M13 7l5 5m0 0l-5 5m5-5H6" />
            </svg>
        </Button>
        <p class="text-center text-zinc-400 text-xs italic mt-4">Al hacer clic, serás redirigido a la pasarela de pago segura.</p>
        </div>
    </div>

    <!-- Summary Sidebar -->
    <aside class="lg:col-span-4">
        <div class="bg-zinc-100 rounded-3xl p-8 sticky top-24">
        <Heading as="h3" class="!text-2xl font-black mb-8">Resumen de Inscripción</Heading>

        <div class="space-y-6 mb-8">
            <div class="flex items-center gap-4">
            <div class="w-10 h-10 bg-blue-100 rounded-xl flex items-center justify-center text-blue-700">
                <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
                </svg>
            </div>
            <div>
                <p class="text-[9px] font-black text-zinc-400 uppercase">Fecha del Evento</p>
                <p class="text-sm font-bold">15 de Octubre, 2024</p>
            </div>
            </div>

            <div class="flex items-center gap-4">
            <div class="w-10 h-10 bg-blue-100 rounded-xl flex items-center justify-center text-blue-700">
                <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
                </svg>
            </div>
            <div>
                <p class="text-[9px] font-black text-zinc-400 uppercase">Punto de Partida</p>
                <p class="text-sm font-bold">Circuito Reforma, CDMX</p>
            </div>
            </div>
        </div>

        <div class="bg-zinc-800 aspect-video rounded-2xl mb-8 overflow-hidden relative">
            <div class="absolute inset-0 bg-gradient-to-br from-blue-900/50 to-purple-900/50"></div>
            <div class="absolute inset-0 flex items-center justify-center">
            <div class="w-3 h-3 bg-blue-500 rounded-full animate-ping"></div>
            </div>
        </div>

        <div class="flex justify-between items-end border-t border-zinc-200 pt-6">
            <div>
            <p class="text-[10px] font-black text-blue-700 uppercase">Costo Total</p>
            <p id="total-price" class="text-4xl font-black text-blue-900">$450.00</p>
            </div>
            <span class="text-[10px] font-bold text-zinc-400 bg-zinc-200 px-3 py-1 rounded">MXN</span>
        </div>
        </div>
    </aside>
    </div>
</div>