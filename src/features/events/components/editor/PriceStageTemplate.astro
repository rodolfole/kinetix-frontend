---
import { Input } from '@/components/starwind/input';
import { Label } from '@/components/starwind/label';
---

<template id="price-stage-tpl">
  <div
    class="card border rounded-lg p-4 bg-white shadow-sm animate-fade-up space-y-3"
  >
    <div class="flex justify-between items-center">
      <div class="flex items-center gap-3">
        <span
          class="stage-badge bg-blue-100 text-blue-700 text-[10px] font-bold px-2 py-1 rounded uppercase"
        >
          Regular
        </span>
        <Input
          data-name="name"
          placeholder="Nombre (Ej. Early Bird)"
          class="border-none shadow-none h-auto p-0 font-semibold text-sm focus-visible:ring-0 bg-transparent"
        />
      </div>
      <button type="button" class="remove-item text-red-500" aria-label="Eliminar etapa">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="6" x2="6" y2="18" /><line x1="6" y1="6" x2="18" y2="18" /></svg>
      </button>
    </div>

    <div class="grid gap-4 md:grid-cols-4 items-end">
      <div class="space-y-1">
        <Label class="text-[10px] uppercase text-muted-foreground">Distancia Asociada</Label>
        <select
          data-name="distance_id"
          required
          class="distance-select flex h-10 w-full rounded-md border border-zinc-200 bg-white px-3 text-sm shadow-sm focus:border-blue-500 focus:ring-2 focus:ring-blue-100 outline-none"
        >
          <option value="">Seleccionar…</option>
        </select>
      </div>
      <div class="space-y-1">
        <Label class="text-[10px] uppercase text-muted-foreground">Precio ($)</Label>
        <Input
          type="number"
          data-name="price"
          placeholder="0.00"
          min="0"
          required
        />
      </div>
      <div class="space-y-1">
        <Label class="text-[10px] uppercase text-muted-foreground">Inicio</Label>
        <Input type="date" data-name="start_date" required />
      </div>
      <div class="space-y-1">
        <Label class="text-[10px] uppercase text-muted-foreground">Fin</Label>
        <Input type="date" data-name="end_date" required />
      </div>
      <div
        class="flex items-center gap-2 pt-2 md:pt-0 border-t md:border-t-0 md:border-l md:pl-4 border-dashed"
      >
        <input
          type="checkbox"
          data-name="is_early_bird"
          id="early-bird-check"
          class="rounded border-gray-300 text-green-600 focus:ring-green-500"
        />
        <Label
          for="early-bird-check"
          class="text-xs font-medium text-gray-600 cursor-pointer select-none"
        >
          Es Early Bird
        </Label>
      </div>
    </div>
  </div>
</template>
