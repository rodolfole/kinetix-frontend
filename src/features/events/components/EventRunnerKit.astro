---
import { Heading } from '@shared/components';
import type { BaseEvent, RunnerKitItem } from '@features/events/types/event.type';
import {
  Shirt, Trophy, Medal, Backpack, Timer,
  MapPin, Utensils, HeartPulse, Gift, Package,
} from '@lucide/astro';

export interface Props {
  event: BaseEvent;
}

const { event } = Astro.props;
const items = event.runner_kits ?? [];

if (items.length === 0) return;

type IconComponent = typeof Shirt;

const ICON_MAP: Record<string, IconComponent> = {
  shirt: Shirt,
  trophy: Trophy,
  medal: Medal,
  backpack: Backpack,
  timer: Timer,
  'map-pin': MapPin,
  utensils: Utensils,
  'heart-pulse': HeartPulse,
  gift: Gift,
  package: Package,
};
---

<section class="bg-surface-container-low">
  <div class="mx-auto max-w-7xl px-4 py-16 sm:px-6 lg:px-8">
    <Heading level={2}>Kit del Corredor</Heading>
    <p class="mt-2 text-on-surface-variant">Artículos incluidos para todos los participantes</p>

    <div class="mt-8 grid gap-4 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4">
      {
        items.map((item: RunnerKitItem) => {
          const IconComponent = ICON_MAP[item.icon] || Package;
          return (
            <div class="rounded-lg border border-surface-variant/20 bg-surface-container-highest p-5 shadow-sm transition-shadow hover:shadow-md">
              <div class="flex items-start gap-4">
                <div class="flex h-12 w-12 shrink-0 items-center justify-center rounded-full bg-primary/10 text-primary">
                  <IconComponent class="h-6 w-6" />
                </div>
                <div class="min-w-0 flex-1">
                  <h3 class="text-sm font-semibold text-on-surface">{item.name}</h3>
                  {
                    item.description && (
                      <p class="mt-1 text-xs text-on-surface-variant">{item.description}</p>
                    )
                  }
                </div>
              </div>
            </div>
          );
        })
      }
    </div>
  </div>
</section>
