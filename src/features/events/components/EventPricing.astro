---
import type { BaseEvent } from '@features/events/types/event.type';
import { formatPrice } from '@lib/mock-data';
import { Heading } from '@shared/components';
import { isAuthenticated } from '@/lib/auth';

export interface Props {
  event: BaseEvent;
}

const { event } = Astro.props;

// Verificar autenticación
const authenticated = isAuthenticated(Astro);

// URL según estado de auth
const registerUrl = authenticated 
  ? `/events/${event.slug}/registration`
  : `/auth/register?redirect=${event.slug}`;

const phases = [
  { name: 'Early Bird', deadline: 'Oct 01', price: event.pricing.basePrice * 0.8, current: false },
  { name: 'Standard', deadline: 'Nov 01', price: event.pricing.basePrice, current: true },
  { name: 'Last Call', deadline: 'Dec 01', price: event.pricing.basePrice * 1.3, current: false },
];
---

<section class="py-24 bg-surface-container-low border-y border-surface-variant/20">
  <div class="container mx-auto px-6">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-16 items-start">
      <div class="lg:col-span-7">
        <div class="mb-12">
          <Heading 
            as="h2" 
            size="lg" 
            class="tracking-tight mb-4 !text-4xl"
          >
            Tiered Pricing
          </Heading>
          <p class="text-on-surface-variant text-lg">
            Our pricing is designed to reward early registration. The earlier you sign up, the more you save. 
            All registrations include your official race bib, timing chip, commemorative medal, and post-race amenities.
          </p>
        </div>

        <div class="space-y-4">
          {phases.map((phase) => (
            <div class={`p-6 rounded-xl border transition-all ${phase.current ? 'bg-white border-primary shadow-md' : 'bg-white/50 border-surface-variant'}`}>
              <div class="flex items-center justify-between">
                <div class="flex items-center gap-4">
                  <div class={`w-3 h-3 rounded-full ${phase.current ? 'bg-primary' : 'bg-surface-variant'}`}></div>
                  <div>
                    <h4 class="font-bold text-lg">{phase.name}</h4>
                    <p class="text-sm text-on-surface-variant">Deadline: {phase.deadline}</p>
                  </div>
                </div>
                <div class="text-right">
                  <span class="text-2xl font-black text-primary">{formatPrice(phase.price)}</span>
                  {phase.current && (
                    <span class="ml-2 text-xs font-bold bg-primary text-on-primary px-2 py-0.5 rounded">CURRENT</span>
                  )}
                </div>
              </div>
            </div>
          ))}
        </div>
      </div>

      <div class="lg:col-span-5 space-y-8">
        <div class="p-6 bg-surface-container-lowest rounded-xl border-l-4 border-primary shadow-sm">
          <Heading 
            as="h4" 
            size="sm" 
            class="mb-3 flex items-center gap-2 !text-xl"
          >
            <svg class="w-6 h-6 text-primary" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 12a9 9 0 01-9 9m9-9a9 9 0 00-9-9m9 9H3m9 9a9 9 0 01-9-9m9 9c1.657 0 3-4.03 3-9s-1.343-9-3-9m0 18c-1.657 0-3-4.03-3-9s1.343-9 3-9m-9 9a9 9 0 019-9" />
            </svg>
            Online Portal
          </Heading>
          <p class="text-on-surface-variant mb-4">
            Fastest way to secure your bib. Pay via Credit Card, PayPal, or Apple Pay through our secure encrypted platform.
          </p>
          <a
            href={registerUrl}
            class="text-primary font-bold hover:underline flex items-center gap-1"
          >
            Open Registration Portal
            <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7l5 5m0 0l-5 5m5-5H6" />
            </svg>
          </a>
        </div>

        <div class="p-6 bg-surface-container-lowest rounded-xl border-l-4 border-secondary shadow-sm">
          <Heading 
            as="h4" 
            size="sm"
            class="mb-3 flex items-center gap-2 !text-xl"
          >
            <svg class="w-6 h-6 text-secondary" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4" />
            </svg>
            In-Person Partners
          </Heading>
          <p class="text-on-surface-variant mb-4">
            Register at any of our official partner retail locations:
          </p>
          <ul class="text-sm space-y-2 text-on-surface-variant font-medium">
            <li class="flex justify-between border-b border-surface-variant/10 pb-1">
              <span>Kinetic Sports Hub - City Center</span>
              <span>9:00 - 21:00</span>
            </li>
            <li class="flex justify-between border-b border-surface-variant/10 pb-1">
              <span>Runner's Paradise - North Mall</span>
              <span>10:00 - 20:00</span>
            </li>
            <li class="flex justify-between">
              <span>Sports Depot - Downtown</span>
              <span>8:00 - 22:00</span>
            </li>
          </ul>
        </div>
      </div>
    </div>
  </div>
</section>