---
import { formatPrice } from '@lib/mock-data';
import type { BaseEvent } from '../types/event.type';
import { Heading } from '@shared/components';
import { isAuthenticated } from '@/lib/auth';

export interface Props {
  event: BaseEvent;
}

const { event } = Astro.props;

// Verificar autenticación
const authenticated = isAuthenticated(Astro);

// URL según estado de auth
const registerUrl = authenticated 
  ? `/events/${event.slug}/registration`
  : `/auth/register?redirect=${event.slug}`;
---

<section class="py-32 relative overflow-hidden">
  <div class="absolute inset-0 bg-primary">
    <img
      src={event.images.gallery?.[1] || event.images.hero}
      alt=""
      class="w-full h-full object-cover opacity-20"
    />
  </div>

  <div class="relative z-10 container mx-auto px-6 text-center">
    <Heading 
      as="h2" 
      size="xl"
      class="italic text-on-primary mb-8 !text-5xl md:!text-7xl"
    >
      BECOME LEGENDARY.
    </Heading>
    <p class="text-on-primary/80 text-xl font-body max-w-xl mx-auto mb-12">
      Spaces are filling fast. Secure your bib for the most anticipated athletic event of the season.
    </p>

    <div class="flex flex-col sm:flex-row justify-center gap-4">
      <a
        href={registerUrl}
        class="bg-white text-primary px-10 py-5 rounded-md font-headline font-extrabold text-lg shadow-xl hover:bg-surface-container-lowest transition-colors"
      >
        START REGISTRATION
      </a>
      <a
        href="#requirements"
        class="bg-transparent border-2 border-white/40 text-white px-10 py-5 rounded-md font-headline font-extrabold text-lg hover:bg-white/10 transition-colors"
      >
        VIEW REQUIREMENTS
      </a>
    </div>
  </div>
</section>