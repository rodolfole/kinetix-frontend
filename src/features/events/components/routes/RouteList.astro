---
import type { RouteData } from '@features/events/types/route.type';

/**
 * Server-rendered route list (PLAN-11 T10.2, was `RouteList.tsx` + client:load).
 * The markup is rendered here; `route-list.boot.ts` wires the delete action.
 */
export interface Props {
  routes: RouteData[];
}

const { routes } = Astro.props;

const formatDate = (value: string) => {
  try {
    return new Date(value).toLocaleDateString('es-MX', {
      year: 'numeric',
      month: 'short',
      day: 'numeric',
    });
  } catch {
    return value;
  }
};
---

<div class="space-y-4" data-route-list>
  <div
    class="hidden p-3 rounded-xl bg-red-50 border border-red-200 text-sm text-red-700"
    data-route-list-error
    hidden
  >
  </div>

  {
    routes.length === 0 ? (
      <div class="rounded-xl bg-surface-container-low p-12 text-center">
        <svg
          class="w-12 h-12 mx-auto mb-4 text-on-surface-variant/50"
          fill="none"
          viewBox="0 0 24 24"
          stroke="currentColor"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="1"
            d="M9 20l-5.447-2.724A1 1 0 013 16.382V5.618a1 1 0 011.447-.894L9 7m0 13l6-3m-6 3l-6-3m6 3l6 3m6-3l-5.447-2.724A1 1 0 0121 16.382V5.618a1 1 0 00-1.447-.894L15 7m6 13l-3-1.5m0-9l-3-1.5m0 0L9 7m6 0l-6 3m6 0l3 1.5M9 7l6 3m0 0l3-1.5"
          ></path>
        </svg>
        <h3 class="font-bold text-on-surface mb-1">Sin rutas todavia</h3>
        <p class="text-sm text-on-surface-variant">
          Sube un archivo GPX para agregar el recorrido de la carrera
        </p>
      </div>
    ) : (
      <div class="overflow-x-auto rounded-xl border border-surface-container-high">
        <table class="w-full text-sm" data-route-table>
          <thead>
            <tr class="bg-surface-container-low text-on-surface-variant text-xs font-bold uppercase tracking-wider">
              <th class="text-left px-4 py-3">Nombre</th>
              <th class="text-left px-4 py-3">Distancia</th>
              <th class="text-right px-4 py-3">KM</th>
              <th class="text-right px-4 py-3">Desnivel</th>
              <th class="text-left px-4 py-3">Fecha</th>
              <th class="text-right px-4 py-3 w-20">Accion</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-surface-container-high">
            {routes.map((route) => (
              <tr
                class="hover:bg-surface-container-low/50 transition-colors"
                data-route-row
                data-route-id={route.id}
              >
                <td class="px-4 py-3 font-bold text-on-surface">{route.name || 'Sin nombre'}</td>
                <td class="px-4 py-3 text-on-surface-variant">
                  {route.distance_id ? 'Asignada' : 'Sin distancia'}
                </td>
                <td class="px-4 py-3 text-right font-mono text-on-surface">
                  {route.total_distance_km?.toFixed(1) ?? '-'}
                </td>
                <td class="px-4 py-3 text-right font-mono text-on-surface">
                  {route.total_elevation_gain != null
                    ? `${route.total_elevation_gain.toFixed(0)}m`
                    : '-'}
                </td>
                <td class="px-4 py-3 text-on-surface-variant">{formatDate(route.created_at)}</td>
                <td class="px-4 py-3 text-right">
                  <button
                    type="button"
                    class="text-red-500 hover:text-red-700 transition-colors disabled:opacity-50 disabled:cursor-not-allowed"
                    title="Eliminar ruta"
                    data-route-delete={route.id}
                  >
                    <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                      <path
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        stroke-width="2"
                        d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"
                      ></path>
                    </svg>
                  </button>
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    )
  }

  <p class="text-xs text-on-surface-variant text-right" data-route-list-count>
    {
      routes.length === 1
        ? '1 ruta registrada'
        : `${routes.length} rutas registradas`
    }
  </p>
</div>

<script>
  import '@features/events/components/routes/route-list.boot';
</script>
