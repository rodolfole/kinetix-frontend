---
export interface Props {
  title: string;
  value: string | number;
  description?: string;
  icon?: string;
  trend?: {
    value: number;
    positive: boolean;
  };
}

const { title, value, description, icon = 'activity', trend } = Astro.props;
---

<div class="rounded-xl border bg-card text-card-foreground shadow-sm p-6">
  <div class="flex items-center justify-between">
    <div>
      <p class="text-sm font-medium text-muted-foreground">{title}</p>
      <p class="text-3xl font-bold mt-2">{value}</p>
      {description && <p class="text-xs text-muted-foreground mt-1">{description}</p>}
    </div>
    
    <div class="w-12 h-12 bg-blue-100 rounded-xl flex items-center justify-center text-blue-600">
      {icon === 'calendar' && (
        <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <rect x="3" y="4" width="18" height="18" rx="2" />
          <path d="M16 2v4M8 2v4M3 10h18" />
        </svg>
      )}
      {icon === 'users' && (
        <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path d="M17 21v-2a4 4 0 00-4-4H5a4 4 0 00-4 4v2" />
          <circle cx="9" cy="7" r="4" />
          <path d="M23 21v-2a4 4 0 00-3-3.87M16 3.13a4 4 0 010 7.75" />
        </svg>
      )}
      {icon === 'dollar-sign' && (
        <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path d="M12 1v22M17 5H9.5a3.5 3.5 0 000 7h5a3.5 3.5 0 010 7H6" />
        </svg>
      )}
      {icon === 'trending-up' && (
        <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <polyline points="23 6 13.5 15.5 8.5 10.5 1 18" />
          <polyline points="17 6 23 6 23 12" />
        </svg>
      )}
      {icon === 'activity' && (
        <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <polyline points="22 12 18 12 15 21 9 3 6 12 2 12" />
        </svg>
      )}
    </div>
  </div>
  
  {trend && (
    <div class="flex items-center mt-4 pt-4 border-t">
      <span class:list={[
        "text-sm font-medium",
        trend.positive ? "text-green-600" : "text-red-600"
      ]}>
        {trend.positive ? '↑' : '↓'} {Math.abs(trend.value)}%
      </span>
      <span class="text-xs text-muted-foreground ml-2">vs last month</span>
    </div>
  )}
</div>
