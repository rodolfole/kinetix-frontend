---
import {
  LayoutDashboard,
  CalendarDays,
  PlusCircle,
  Users,
  BarChart3,
  Settings,
  Bolt,
} from "@lucide/astro";
import {
  Sidebar,
  SidebarContent,
  SidebarFooter,
  SidebarHeader,
  SidebarMenu,
  SidebarMenuButton,
  SidebarMenuItem,
  SidebarRail,
  SidebarSeparator,
} from "@/components/starwind/sidebar";

export interface SidebarItem {
  icon: string;
  label: string;
  href: string;
  active?: boolean;
  badge?: string;
}

export interface Props {
  items: SidebarItem[];
  class?: string;
}

const { items, class: className } = Astro.props;

const iconMap: Record<string, typeof LayoutDashboard> = {
  'layout-dashboard': LayoutDashboard,
  'calendar': CalendarDays,
  'plus-circle': PlusCircle,
  'users': Users,
  'bar-chart': BarChart3,
  'settings': Settings,
};

const defaultItems = [
  { icon: 'layout-dashboard', label: 'Dashboard', href: '/dashboard', active: false },
  { icon: 'calendar', label: 'My Events', href: '/dashboard/events', active: false },
  { icon: 'plus-circle', label: 'Create Event', href: '/dashboard/events/new', active: false },
  { icon: 'users', label: 'Participants', href: '/dashboard/participants', active: false },
  { icon: 'bar-chart', label: 'Reports', href: '/dashboard/reports', active: false },
  { icon: 'settings', label: 'Settings', href: '/dashboard/settings', active: false },
];

const finalItems = items || defaultItems;
---

<Sidebar collapsible="icon" class={className}>
  <!-- Logo -->
  <SidebarHeader>
    <SidebarMenu>
      <SidebarMenuItem>
        <SidebarMenuButton size="lg">
          <div class="bg-blue-600 text-white flex aspect-square size-10 items-center justify-center rounded-lg">
            <Bolt class="size-5" />
          </div>
          <div class="grid flex-1 text-left text-sm leading-tight">
            <span class="truncate font-semibold">Kinetix</span>
            <span class="text-sidebar-foreground/70 truncate text-xs">Organizer Hub</span>
          </div>
        </SidebarMenuButton>
      </SidebarMenuItem>
    </SidebarMenu>
  </SidebarHeader>

  <SidebarSeparator />

  <!-- Navigation -->
  <SidebarContent>
    <SidebarMenu>
      {finalItems.map((item) => {
        const IconComponent = iconMap[item.icon] || LayoutDashboard;
        return (
          <SidebarMenuItem>
            <SidebarMenuButton
              href={item.href}
              isActive={item.active || false}
              tooltip={item.label}
              data-active={item.active || false}
              class="data-[active=true]:bg-blue-600 data-[active=true]:text-white"
            >
              <IconComponent />
              <span>{item.label}</span>
              {item.badge && (
                <span class="ml-auto bg-sidebar-accent-foreground/10 text-xs px-2 py-0.5 rounded-full">
                  {item.badge}
                </span>
              )}
            </SidebarMenuButton>
          </SidebarMenuItem>
        );
      })}
    </SidebarMenu>
  </SidebarContent>

  <!-- Optional Footer -->
  <SidebarFooter>
    <!-- Add footer content here if needed -->
  </SidebarFooter>

  <SidebarRail />
</Sidebar>
