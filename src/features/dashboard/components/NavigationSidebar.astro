---
import {
  LayoutDashboard,
  CalendarDays,
  CalendarCheck,
  PlusCircle,
  Users,
  BarChart3,
  Settings,
  Ruler,
  User,
  History,
  Trophy,
} from "@lucide/astro";
import {
  Sidebar,
  SidebarContent,
  SidebarFooter,
  SidebarHeader,
  SidebarMenu,
  SidebarMenuButton,
  SidebarMenuItem,
  SidebarRail,
  SidebarSeparator,
} from "@/components/starwind/sidebar";

export interface SidebarItem {
  icon: string;
  label: string;
  href: string;
  active?: boolean;
  badge?: string;
}

export interface Props {
  items: SidebarItem[];
  title?: string;
  subtitle?: string;
  class?: string;
}

const { items, title = 'Kinetix', subtitle = 'Dashboard', class: className } = Astro.props;

const iconMap: Record<string, any> = {
  'layout-dashboard': LayoutDashboard,
  'calendar': CalendarDays,
  'calendar-check': CalendarCheck,
  'plus-circle': PlusCircle,
  'users': Users,
  'bar-chart': BarChart3,
  'settings': Settings,
  'ruler': Ruler,
  'user': User,
  'history': History,
  'trophy': Trophy,
};
---

<Sidebar collapsible="icon" class={className}>
  <!-- Logo -->
  <SidebarHeader>
    <SidebarMenu>
      <SidebarMenuItem>
        <SidebarMenuButton size="lg">
          <div class="bg-blue-600 text-white flex aspect-square size-10 items-center justify-center rounded-lg">
            <Trophy class="size-5" />
          </div>
          <div class="grid flex-1 text-left text-sm leading-tight">
            <span class="truncate font-semibold">{title}</span>
            <span class="text-sidebar-foreground/70 truncate text-xs">{subtitle}</span>
          </div>
        </SidebarMenuButton>
      </SidebarMenuItem>
    </SidebarMenu>
  </SidebarHeader>

  <SidebarSeparator />

  <!-- Navigation -->
  <SidebarContent>
    <SidebarMenu>
      {items.map((item) => {
        const IconComponent = iconMap[item.icon] || LayoutDashboard;
        return (
          <SidebarMenuItem>
            <SidebarMenuButton
              href={item.href}
              isActive={item.active || false}
              tooltip={item.label}
              data-active={item.active || false}
              class="data-[active=true]:bg-blue-600 data-[active=true]:text-white"
            >
              <IconComponent />
              <span>{item.label}</span>
              {item.badge && (
                <span class="ml-auto bg-sidebar-accent-foreground/10 text-xs px-2 py-0.5 rounded-full">
                  {item.badge}
                </span>
              )}
            </SidebarMenuButton>
          </SidebarMenuItem>
        );
      })}
    </SidebarMenu>
  </SidebarContent>

  <SidebarFooter>
    <!-- Add footer content here if needed -->
  </SidebarFooter>

  <SidebarRail />
</Sidebar>