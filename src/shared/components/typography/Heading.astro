---
export interface Props {
  as?: 'h1' | 'h2' | 'h3' | 'h4' | 'h5' | 'h6';
  size?: 'sm' | 'md' | 'lg' | 'xl';
  class?: string;
}

const { as: Tag = 'h2', size = 'lg', class: className = '' } = Astro.props;

const sizeStyles: Record<NonNullable<Props['size']>, string> = {
  sm: 'text-lg font-normal',
  md: 'text-xl font-medium',
  lg: 'text-2xl md:text-3xl font-bold',
  xl: 'text-3xl md:text-4xl font-bold',
};
---

<Tag class:list={[sizeStyles[size], 'text-gray-900', className]}>
  <slot />
</Tag>