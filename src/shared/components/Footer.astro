---
import Button from '@shared/components/ui/Button.astro';

const currentYear = new Date().getFullYear();
const footerLinks = [
  { label: 'Contact Support', href: '/contacto' },
  { label: 'Privacy Policy', href: '/privacidad' },
  { label: 'Terms of Service', href: '/terminos' },
  { label: 'Race Director Portal', href: '/organizador' },
];
---

<footer class="bg-zinc-100 w-full mt-auto py-12 px-8">
  <div class="max-w-7xl mx-auto flex flex-col md:flex-row justify-between items-center gap-6">
    <div class="flex flex-col items-center md:items-start gap-2">
      <span class="text-blue-700 font-black text-xl font-headline">KINETIC PRECISION</span>
      <p class="text-zinc-500 font-medium text-xs tracking-widest uppercase">
        © {currentYear} KINETIC PRECISION. ALL RIGHTS RESERVED.
      </p>
    </div>

    <div class="flex flex-wrap justify-center gap-6 font-body text-xs tracking-widest uppercase">
      {footerLinks.map((link) => (
        <a
          href={link.href}
          class="text-zinc-500 font-medium hover:text-blue-600 transition-colors"
        >
          {link.label}
        </a>
      ))}
    </div>

    <div class="flex gap-4">
      <Button
        type="button"
        variant="outline"
        class="!w-10 !h-10 !p-0 rounded-full !border-zinc-200 text-zinc-400 hover:!text-blue-700 hover:!border-blue-700 transition-all"
        aria-label="Share"
      >
        <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8.684 13.342C8.886 12.938 9 12.482 9 12c0-.482-.114-.938-.316-1.342m0 2.684a3 3 0 110-2.684m0 2.684l6.632 3.316m-6.632-6l6.632-3.316m0 0a3 3 0 105.367-2.684 3 3 0 00-5.367 2.684zm0 9.316a3 3 0 105.368 2.684 3 3 0 00-5.368-2.684z" />
        </svg>
      </Button>

      <Button
        type="button"
        variant="outline"
        class="!w-10 !h-10 !p-0 rounded-full !border-zinc-200 text-zinc-400 hover:!text-blue-700 hover:!border-blue-700 transition-all"
        aria-label="Website"
      >
        <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 12a9 9 0 01-9 9m9-9a9 9 0 00-9-9m9 9H3m9 9a9 9 0 01-9-9m9 9c1.657 0 3-4.03 3-9s-1.343-9-3-9m0 18c-1.657 0-3-4.03-3-9s1.343-9 3-9m-9 9a9 9 0 019-9" />
        </svg>
      </Button>
    </div>
  </div>
</footer>