---
import FormError from './FormError.astro';
import FormLabel from './FormLabel.astro';

interface Props extends astroHTML.JSX.SelectHTMLAttributes {
  label: string;
  id: string;
  error?: string;
  options: { value: string; label: string; disabled?: boolean }[];
  placeholder?: string; 
}

const { 
  label,
  name,
  id,
  error,
  class: className,
  value,
  children,
  options,
  placeholder,
  ...rest 
} = Astro.props;
---

<div class:list={["flex flex-col gap-1 w-full", className]}>
  <FormLabel for={id} class="text-xs font-bold uppercase tracking-widest text-primary/70">
    {label} {Astro.props.required && <span class="text-red-500">*</span>}
  </FormLabel>

  <div
    class:list={[
      "relative bg-surface-container-low px-4 py-3 transition-all",
      { "border-error!": error }
    ]}
  >
    <select
      name={name}
      id={id}
      class="w-full px-4 py-4 bg-surface-container-high border-none rounded-md focus:ring-2 focus:ring-primary font-body"
      {...rest}
    >
      {placeholder && (
        <option value="" disabled selected={!value}>
          {placeholder}
        </option>
      )}

      {options.map((option) => (
        <option 
          value={option.value} 
          selected={option.value === value}
          disabled={option.disabled}
        >
          {option.label}
        </option>
      ))}
    </select>

    <div class="absolute right-4 top-1/2 -translate-y-1/2 pointer-events-none text-primary/50">
      <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M19 9l-7 7-7-7" />
      </svg>
    </div>
  </div>

  {error && <FormError message={error} />}
</div>