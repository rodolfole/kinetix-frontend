---
import '../styles/starwind.css';
import { ClientRouter } from 'astro:transitions';
import {
  SidebarProvider,
  SidebarInset,
  SidebarTrigger,
} from '@/components/starwind/sidebar';
import { NavigationSidebar, UserActions } from '@features/dashboard/components';

export interface Props {
  title: string;
}

// El middleware ya verificó la auth - aquí solo necesitamos los datos del usuario
const userCookie = Astro.cookies.get('user');
let user = null;
if (userCookie?.value) {
  try {
    user = JSON.parse(userCookie.value);
  } catch {
    // Si falla el parse, el middleware ya habrá redirect
  }
}

const sidebarItems = [
  { icon: 'calendar-check', label: 'Mis Inscripciones', href: '/participant/dashboard/registrations', active: Astro.url.pathname.includes('/registrations') },
  { icon: 'ruler', label: 'Mi Perfil', href: '/participant/dashboard/profile', active: Astro.url.pathname.includes('/profile') },
  { icon: 'history', label: 'Historial', href: '/participant/dashboard/history', active: Astro.url.pathname.includes('/history') },
  { icon: 'settings', label: 'Configuración', href: '/participant/dashboard/settings', active: Astro.url.pathname.includes('/settings') },
];

const { title } = Astro.props;
---

<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title}</title>
  <ClientRouter />
</head>
<body>
  <SidebarProvider defaultOpen={true}>
    <div class="flex min-h-screen w-full">
      <NavigationSidebar 
        items={sidebarItems} 
        subtitle="Mis Carreras" 
      />
      <SidebarInset>
        <header class="flex h-12 shrink-0 items-center gap-2 border-b px-4 bg-background sticky top-0 z-40">
          <SidebarTrigger />
          <h2 class="text-lg font-semibold">{title}</h2>
          <div class="ml-auto">
            <UserActions user={user || undefined} />
          </div>
        </header>

        <div class="flex-1 p-6">
          <slot />
        </div>
      </SidebarInset>
    </div>
  </SidebarProvider>
</body>
</html>