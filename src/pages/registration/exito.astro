---
import MainLayout from '@layouts/MainLayout.astro';
---
<MainLayout title="Inscripción recibida · Kinetix">
  <section class="mx-auto flex min-h-[60vh] max-w-xl flex-col items-center justify-center px-4 text-center">
    <div class="mb-6 flex h-20 w-20 items-center justify-center rounded-full bg-green-100">
      <svg class="h-10 w-10 text-green-600" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="3">
        <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
      </svg>
    </div>
    <h1 class="text-3xl font-bold text-slate-900">¡Inscripción recibida!</h1>
    <p class="mt-3 text-slate-600">
      Hemos recibido tu registro. Te enviaremos un correo de confirmación con los detalles del evento.
    </p>
    <div class="mt-8 flex gap-3">
      <a href="/events" class="rounded-lg bg-blue-600 px-5 py-2.5 text-sm font-semibold text-white hover:bg-blue-700">
        Ver más eventos
      </a>
      <a href="/" class="rounded-lg border border-slate-300 px-5 py-2.5 text-sm font-semibold text-slate-700 hover:bg-slate-50">
        Inicio
      </a>
    </div>
  </section>
</MainLayout>
