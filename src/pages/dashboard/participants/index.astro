---
import DashboardLayout from '@layouts/DashboardLayout.astro';
import { PageHeader } from '@features/dashboard/components';
---

<DashboardLayout title="Participants">
  <PageHeader
    title="Participants"
    description="Lista de corredores inscritos en tus eventos."
  />

  <div class="rounded-xl border bg-card p-12 text-center">
    <p class="text-muted-foreground">
      Esta sección está en construcción. Próximamente verás aquí la lista consolidada
      de participantes inscritos en tus eventos.
    </p>
  </div>
</DashboardLayout>