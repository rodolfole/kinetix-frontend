---
import DashboardLayout from '@layouts/DashboardLayout.astro';
import { PageHeader } from '@features/dashboard/components';
---

<DashboardLayout title="Reports">
  <PageHeader
    title="Reports"
    description="Reportes e indicadores de tus eventos."
  />

  <div class="rounded-xl border bg-card p-12 text-center">
    <p class="text-muted-foreground">
      Esta sección está en construcción. Próximamente verás reportes de inscripción,
      ingresos y ocupación por evento.
    </p>
  </div>
</DashboardLayout>