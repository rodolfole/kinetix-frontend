---
import { Button } from '@/components/starwind/button';
import { Badge } from '@/components/starwind/badge';
import { PageHeader, StatCard, EventCard } from '@features/dashboard/components';
import { dashboard } from '@features/dashboard/actions/dashboard.action';
import AppShellLayout from '@layouts/AppShellLayout.astro';

// Real data: the action aggregates `/events` + `/registrations?event_id=` (§T6).
const overviewRes = await Astro.callAction(dashboard.getOrganizerOverview, { recentLimit: 4 });
const overview = overviewRes.data ?? null;
const loadError = overviewRes.error?.message ?? null;

const stats = overview?.stats ?? { totalEvents: 0, activeEvents: 0, totalRegistrations: 0 };
const recentEvents = overview?.recentEvents ?? [];
const deadlines = overview?.deadlines ?? [];
const distanceDistribution = overview?.distanceDistribution ?? [];
const isEmpty = recentEvents.length === 0;

const formatDeadline = (value: string) =>
  new Date(value).toLocaleDateString('es-MX', { day: '2-digit', month: 'short', year: 'numeric' });
---

<AppShellLayout title="Dashboard">
  <PageHeader
    title="Resumen"
    description="Estos son los números reales de tus eventos."
  />

  {loadError && (
    <div class="mb-8 rounded-xl border border-red-200 bg-red-50 p-4 text-sm text-red-700">
      No pudimos cargar tus eventos: {loadError}
    </div>
  )}

  <!-- Stats Grid -->
  <div class="grid gap-6 md:grid-cols-3 mb-8">
    <StatCard
      title="Eventos"
      value={stats.totalEvents}
      description="Creados en tu cuenta"
      icon="calendar"
    />
    <StatCard
      title="Eventos publicados"
      value={stats.activeEvents}
      description={`De ${stats.totalEvents} en total`}
      icon="trending-up"
    />
    <StatCard
      title="Inscripciones"
      value={stats.totalRegistrations.toLocaleString('es-MX')}
      description="En todos tus eventos"
      icon="users"
    />
  </div>

  <!-- Main Content Grid -->
  <div class="grid gap-8 lg:grid-cols-3">

    <!-- Events List -->
    <div class="lg:col-span-2">
      <div class="flex items-center justify-between mb-6">
        <h2 class="text-xl font-semibold">Eventos recientes</h2>
        <Button variant="outline" size="sm" href="/dashboard/events">
          Ver todos
          <svg class="w-4 h-4 ml-2" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path d="M9 18l6-6-6-6" />
          </svg>
        </Button>
      </div>

      {isEmpty ? (
        <div class="rounded-xl border-2 border-dashed border-zinc-300 p-10 text-center">
          <h3 class="font-semibold text-lg">Aún no tienes eventos</h3>
          <p class="text-sm text-muted-foreground mt-1">
            Crea tu primera carrera para ver aquí sus inscripciones y ocupación.
          </p>
          <Button href="/dashboard/events/new" class="mt-4">Crear evento</Button>
        </div>
      ) : (
        <div class="grid gap-4 sm:grid-cols-2">
          {recentEvents.map((event) => (
            <EventCard event={event} />
          ))}
        </div>
      )}

      <!-- Quick Action -->
      <div class="mt-6">
        <a
          href="/dashboard/events/new"
          class="flex items-center justify-center gap-2 w-full p-6 border-2 border-dashed border-zinc-300 rounded-xl hover:border-blue-500 hover:bg-blue-50/50 transition-all group"
        >
          <div class="w-10 h-10 bg-zinc-100 group-hover:bg-blue-100 rounded-lg flex items-center justify-center transition-colors">
            <svg class="w-5 h-5 text-zinc-400 group-hover:text-blue-600" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path d="M12 5v14M5 12h14" />
            </svg>
          </div>
          <span class="font-medium text-zinc-500 group-hover:text-blue-600 transition-colors">Crear evento</span>
        </a>
      </div>
    </div>

    <!-- Sidebar -->
    <div class="space-y-6">
      <!-- Upcoming Deadlines -->
      <div class="rounded-xl border bg-card text-card-foreground shadow-sm p-6">
        <div class="flex items-center gap-2 mb-4">
          <svg class="w-5 h-5 text-orange-500" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <circle cx="12" cy="12" r="10" />
            <path d="M12 6v6l4 2" />
          </svg>
          <h3 class="font-semibold">Próximos cierres</h3>
        </div>
        {deadlines.length === 0 ? (
          <p class="text-sm text-muted-foreground">
            Sin fechas límite de inscripción próximas.
          </p>
        ) : (
          <div class="space-y-4">
            {deadlines.map((deadline) => (
              <div class="flex items-start gap-3 pb-4 last:pb-0 border-b last:border-0">
                <div class="w-2 h-2 bg-orange-500 rounded-full mt-2 flex-shrink-0"></div>
                <div class="flex-1">
                  <p class="text-sm font-medium">{deadline.event}</p>
                  <div class="flex items-center gap-2 mt-1">
                    <Badge variant="secondary" class="text-[10px]">{deadline.type}</Badge>
                    <span class="text-xs text-muted-foreground">{formatDeadline(deadline.date)}</span>
                  </div>
                </div>
              </div>
            ))}
          </div>
        )}
      </div>

      <!-- Distance Distribution -->
      <div class="rounded-xl border bg-card text-card-foreground shadow-sm p-6">
        <h3 class="font-semibold mb-4">Distancias configuradas</h3>
        {distanceDistribution.length === 0 ? (
          <p class="text-sm text-muted-foreground">
            Todavía no hay distancias cargadas en tus eventos.
          </p>
        ) : (
          <div class="space-y-3">
            {distanceDistribution.map((item) => (
              <div class="flex items-center gap-3">
                <div class="w-3 h-3 rounded-full bg-blue-500"></div>
                <span class="text-sm flex-1">{item.label}</span>
                <span class="text-sm font-medium">{item.count}</span>
              </div>
            ))}
          </div>
        )}
      </div>
    </div>
  </div>
</AppShellLayout>
