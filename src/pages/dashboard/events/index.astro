---
import { Button } from '@/components/starwind/button';
import { Badge } from '@/components/starwind/badge';
import { PageHeader, EventCard } from '@features/dashboard/components';
import type { Event } from '@features/dashboard/components/EventCard.astro';
import DashboardLayout from '@layouts/DashboardLayout.astro';

// Mock events data - in production, load from API
const events: Event[] = [
  {
    id: 'event-001',
    slug: '10k-valencia-marathon',
    name: '10K Valencia Marathon',
    date: '2024-12-01T08:00:00Z',
    location: 'Ciudad de las Artes, Valencia',
    status: 'published',
    registered: 8500,
    capacity: 10000,
    revenue: 382500,
  },
  {
    id: 'event-002',
    slug: 'neon-dash-10k',
    name: 'The Neon Dash',
    date: '2024-10-24T20:00:00Z',
    location: 'Downtown Metro',
    status: 'ongoing',
    registered: 1450,
    capacity: 1500,
    revenue: 65250,
  },
  {
    id: 'event-003',
    slug: 'coastal-elite-half',
    name: 'Coastal Elite Half',
    date: '2024-11-12T06:30:00Z',
    location: 'Pacific Highway, CA',
    status: 'published',
    registered: 2145,
    capacity: 3000,
    revenue: 182325,
  },
  {
    id: 'event-004',
    slug: 'summit-peak-trail',
    name: 'Summit Peak Trail',
    date: '2024-12-05T05:00:00Z',
    location: 'Alpine Ridge Trail, CO',
    status: 'draft',
    registered: 0,
    capacity: 800,
    revenue: 0,
  },
  {
    id: 'event-005',
    slug: 'skyline-sprint-5k',
    name: 'Skyline Sprint',
    date: '2024-12-18T18:30:00Z',
    location: 'Central Plaza',
    status: 'published',
    registered: 1750,
    capacity: 2000,
    revenue: 61250,
  },
  {
    id: 'event-006',
    slug: 'desert-ultra-50k',
    name: 'Desert Ultra 50K',
    date: '2025-01-15T04:00:00Z',
    location: 'Sahara Edge, Morocco',
    status: 'draft',
    registered: 0,
    capacity: 200,
    revenue: 0,
  },
];

const stats = {
  total: events.length,
  published: events.filter(e => e.status === 'published').length,
  draft: events.filter(e => e.status === 'draft').length,
  ongoing: events.filter(e => e.status === 'ongoing').length,
};
---

<DashboardLayout title="Events Management">
  <div class="flex items-center justify-between mb-8">
    <PageHeader 
      title="My Events" 
      description="Manage and monitor all your running events."
    />
    <Button href="/dashboard/events/new" class="px-6">
      <svg class="w-4 h-4 mr-2" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
        <path d="M12 5v14M5 12h14" />
      </svg>
      Create Event
    </Button>
  </div>

  <!-- Filter Stats -->
  <div class="flex gap-2 mb-6">
    <Badge variant="secondary" class="px-3 py-1.5 cursor-pointer bg-blue-100 text-blue-700 hover:bg-blue-200">
      All ({stats.total})
    </Badge>
    <Badge variant="secondary" class="px-3 py-1.5 cursor-pointer hover:bg-zinc-100">
      Published ({stats.published})
    </Badge>
    <Badge variant="secondary" class="px-3 py-1.5 cursor-pointer hover:bg-zinc-100">
      Draft ({stats.draft})
    </Badge>
    <Badge variant="secondary" class="px-3 py-1.5 cursor-pointer hover:bg-zinc-100">
      Ongoing ({stats.ongoing})
    </Badge>
  </div>

  <!-- Events Grid -->
  <div class="grid gap-6 md:grid-cols-2 lg:grid-cols-3">
    {events.map((event) => (
      <EventCard event={event} />
    ))}
  </div>

  <!-- Empty state (hidden when events exist) -->
  {events.length === 0 && (
    <div class="flex flex-col items-center justify-center py-20 text-center">
      <div class="w-20 h-20 bg-zinc-100 rounded-full flex items-center justify-center mb-6">
        <svg class="w-10 h-10 text-zinc-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
          <rect x="3" y="4" width="18" height="18" rx="2" />
          <path d="M16 2v4M8 2v4M3 10h18" />
        </svg>
      </div>
      <h3 class="text-xl font-semibold mb-2">No events yet</h3>
      <p class="text-muted-foreground mb-6 max-w-md">Create your first running event to start managing registrations and tracking performance.</p>
      <Button href="/dashboard/events/new">
        <svg class="w-4 h-4 mr-2" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path d="M12 5v14M5 12h14" />
        </svg>
        Create Your First Event
      </Button>
    </div>
  )}
</DashboardLayout>
