---
import { Button } from '@/components/starwind/button';
import { Badge } from '@/components/starwind/badge';
import { PageHeader, EventCard } from '@features/dashboard/components';
import { dashboard } from '@features/dashboard/actions/dashboard.action';
import AppShellLayout from '@layouts/AppShellLayout.astro';

// Real data: same aggregation as the dashboard overview (§T6).
const overviewRes = await Astro.callAction(dashboard.getOrganizerOverview, { recentLimit: 4 });
const events = overviewRes.data?.events ?? [];
const loadError = overviewRes.error?.message ?? null;

const stats = {
  total: events.length,
  published: events.filter((event) => event.status === 'published').length,
  draft: events.filter((event) => event.status === 'draft').length,
  ongoing: events.filter((event) => event.status === 'ongoing').length,
};
---

<AppShellLayout title="Events Management">
  <div class="flex items-center justify-between mb-8">
    <PageHeader
      title="My Events"
      description="Manage and monitor all your running events."
    />
    <Button href="/dashboard/events/new" class="px-6">
      <svg class="w-4 h-4 mr-2" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
        <path d="M12 5v14M5 12h14" />
      </svg>
      Create Event
    </Button>
  </div>

  {loadError && (
    <div class="mb-6 rounded-xl border border-red-200 bg-red-50 p-4 text-sm text-red-700">
      No pudimos cargar tus eventos: {loadError}
    </div>
  )}

  <!-- Filter Stats -->
  <div class="flex gap-2 mb-6">
    <Badge variant="secondary" class="px-3 py-1.5 cursor-pointer bg-blue-100 text-blue-700 hover:bg-blue-200">
      All ({stats.total})
    </Badge>
    <Badge variant="secondary" class="px-3 py-1.5 cursor-pointer hover:bg-zinc-100">
      Published ({stats.published})
    </Badge>
    <Badge variant="secondary" class="px-3 py-1.5 cursor-pointer hover:bg-zinc-100">
      Draft ({stats.draft})
    </Badge>
    <Badge variant="secondary" class="px-3 py-1.5 cursor-pointer hover:bg-zinc-100">
      Ongoing ({stats.ongoing})
    </Badge>
  </div>

  <!-- Events Grid -->
  <div class="grid gap-6 md:grid-cols-2 lg:grid-cols-3">
    {events.map((event) => (
      <EventCard event={event} />
    ))}
  </div>

  <!-- Empty state (hidden when events exist) -->
  {events.length === 0 && (
    <div class="flex flex-col items-center justify-center py-20 text-center">
      <div class="w-20 h-20 bg-zinc-100 rounded-full flex items-center justify-center mb-6">
        <svg class="w-10 h-10 text-zinc-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
          <rect x="3" y="4" width="18" height="18" rx="2" />
          <path d="M16 2v4M8 2v4M3 10h18" />
        </svg>
      </div>
      <h3 class="text-xl font-semibold mb-2">Aún no tienes eventos</h3>
      <p class="text-muted-foreground mb-6 max-w-md">Crea tu primer evento para gestionar inscripciones y seguir su desempeño.</p>
      <Button href="/dashboard/events/new">
        <svg class="w-4 h-4 mr-2" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path d="M12 5v14M5 12h14" />
        </svg>
        Crear evento
      </Button>
    </div>
  )}
</AppShellLayout>
