---
import { actions } from 'astro:actions';
import { Button } from '@/components/starwind/button';
import { Input } from '@/components/starwind/input';
import { Label } from '@/components/starwind/label';
import { Textarea } from '@/components/starwind/textarea';
import { PageHeader } from '@features/dashboard/components';
import FormSection from '@/features/dashboard/components/FormSection.astro';
import ItineraryEditor from '@features/events/components/ItineraryEditor';
import AddressPicker from '@features/events/components/AddressPicker';
import AwardCardTemplate from '@features/events/components/editor/AwardCardTemplate.astro';
import DistanceCardTemplate from '@features/events/components/editor/DistanceCardTemplate.astro';
import PriceStageTemplate from '@features/events/components/editor/PriceStageTemplate.astro';
import SponsorKitTemplates from '@features/events/components/editor/SponsorKitTemplates.astro';
import { OPTIONAL_SECTION_CARDS } from '@features/events/editor/optional-sections';
import { buildFormData, buildInitialSubResources } from '@features/events/editor/subresources';
import AppShellLayout from '@layouts/AppShellLayout.astro';
import { ESTADOS, getMunicipios } from '@lib/mexico-locations';
import RequiredField from '@/shared/components/forms/RequiredField.astro';

const pathSegments = Astro.url.pathname.split('/').filter(Boolean);
const eventSlug = pathSegments[pathSegments.length - 1];
const isEditing = eventSlug && eventSlug !== 'new';

// Load event data from the backend (real API) when editing.
// Falls back to empty data if the slug doesn't exist (404 from backend).
let existingEvent: any = null;
let eventDetail: any = null;
if (isEditing) {
  try {
    const res = await Astro.callAction(actions.event.getBySlug, { slug: eventSlug });
    if (!res.error && res.data) {
      existingEvent = res.data;
    } else if (res.error) {
      console.error('[edit/eventSlug] getBySlug error:', JSON.stringify(res.error));
    }
  } catch (e) {
    console.error('[edit/eventSlug] getBySlug threw:', String(e));
    // Backend unreachable, keep existingEvent = null → empty form
  }

  // Cargar sub-recursos (distancias, pricing, sponsors, kits, locations, itinerary)
  // desde /events/{id}/detail para pre-poblar el formulario en modo edición.
  try {
    const detailRes = await Astro.callAction(actions.event.getEventDetail, { slug: eventSlug });
    if (!detailRes.error && detailRes.data) {
      eventDetail = detailRes.data;
    }
  } catch (e) {
    console.error('[edit/eventSlug] getEventDetail threw:', String(e));
  }
}

// Distance types from backend (km templates).
// Fallback list with popular distances so the form works even when the Go
// backend is unreachable (preview deploys, local first paint, etc.).
let distanceTypes: { id: string; name: string; km: number }[] = [
  { id: '5k', name: '5K', km: 5 },
  { id: '10k', name: '10K', km: 10 },
  { id: '15k', name: '15K', km: 15 },
  { id: '21k', name: '21K (Media Maratón)', km: 21.0975 },
  { id: '42k', name: '42K (Maratón)', km: 42.195 },
  { id: 'ultra', name: 'Ultra 50K', km: 50 },
];
try {
  const distRes = await Astro.callAction(actions.event.getDistanceTypes, {});
  if (!distRes.error && distRes.data && Array.isArray(distRes.data) && distRes.data.length > 0) {
    distanceTypes = distRes.data as { id: string; name: string; km: number }[];
  }
} catch {
  // Keep fallback list when the action throws (backend down / network error).
}

const formData = buildFormData(existingEvent);

const surfaces = [
  { value: 'asphalt', label: 'Asfalto' },
  { value: 'trail', label: 'Trail / Montaña' },
  { value: 'track', label: 'Pista' },
  { value: 'mixed', label: 'Mixto' },
];

const sponsorTiers = [
  { value: 'platinum', label: 'Platinum', color: 'bg-gray-300' },
  { value: 'gold', label: 'Gold', color: 'bg-yellow-400' },
  { value: 'silver', label: 'Silver', color: 'bg-gray-400' },
  { value: 'bronze', label: 'Bronze', color: 'bg-amber-600' },
  { value: 'official', label: 'Official Partner', color: 'bg-blue-500' },
];

// Age categories from backend.
let ageCategories: { id: string; name: string; min_age?: number; max_age?: number; display_order: number }[] = [];
const ageRes = await Astro.callAction(actions.event.getAgeCategories, {});
if (!ageRes.error && ageRes.data) ageCategories = ageRes.data;

// Build JSON dataset the client scripts consume — keeps inline JS tiny and
// avoids bundling TS modules into HTML.
const mexicoDataset = ESTADOS.map((estado) => ({
  estado,
  municipios: getMunicipios(estado),
}));

// Sub-resources pre-poblados para modo edición.
const initialSubResources = buildInitialSubResources(eventDetail);

const initialEstado = formData.state && ESTADOS.includes(formData.state) ? formData.state : '';
const initialMunicipios = initialEstado ? [...getMunicipios(initialEstado)].sort((a, b) => a.localeCompare(b, 'es')) : [];

const pageTitle = isEditing ? 'Editar Evento' : 'Crear Evento';
const pageDescription = isEditing
  ? 'Actualiza la información de tu evento de carrera'
  : 'Completa la información básica para crear tu carrera';
---

<AppShellLayout title={pageTitle}>
  <PageHeader title={pageTitle} description={pageDescription} />

  <form
    id="event-form"
    class="mx-auto w-full max-w-6xl space-y-8 pb-32 px-4 sm:px-6 lg:px-8"
    novalidate
    data-editing={isEditing}
    data-slug={eventSlug ?? ''}
    data-event-id={existingEvent?.id ?? ''}
    data-mexico={JSON.stringify(mexicoDataset)}
    data-estado={initialEstado}
    data-initial-subresources={isEditing ? JSON.stringify(initialSubResources) : ''}
  >
    <!-- ───────── SECCIÓN 1 · INFORMACIÓN BÁSICA ───────── -->
    <FormSection description="Datos principales del evento" title="Información Básica">
      <div class="grid gap-6 md:grid-cols-2">
        <div class="space-y-2">
          <Label for="name">Nombre del Evento <RequiredField /></Label>
          <Input
            id="name"
            name="name"
            placeholder="Ej. Maratón 10K Valencia"
            value={formData.name}
            required
          />
        </div>
        <div class="space-y-2">
          <Label for="slug">URL Amigable (Slug)</Label>
          <Input
            id="slug"
            name="slug"
            placeholder="se-genera-automaticamente"
            value={formData.slug}
            readonly
            aria-readonly="true"
            class="font-mono bg-zinc-50 text-zinc-500 cursor-not-allowed"
          />
          <p class="text-[11px] text-muted-foreground">Se genera automáticamente a partir del nombre (o en el backend si se deja vacío).</p>
        </div>
      </div>
      <div class="mt-6">
        <Label for="description">Descripción del Evento <RequiredField /></Label>
        <Textarea
          id="description"
          name="description"
          placeholder="Detalla la experiencia de la carrera..."
          value={formData.description}
          rows={5}
          required
        />
      </div>
      <div class="mt-4 space-y-2">
        <Label for="logo_url">URL del Logotipo</Label>
        <Input
          id="logo_url"
          name="logo_url"
          type="url"
          placeholder="https://example.com/logo.png"
          value={formData.logo_url}
        />
      </div>
    </FormSection>

    <!-- ───────── SECCIÓN 2 · FECHA Y UBICACIÓN ───────── -->
    <FormSection description="Cuándo y dónde tendrá lugar el evento" title="Fecha y ubicación">
      <div class="grid gap-6 sm:grid-cols-2">
        <div class="space-y-2">
          <Label for="event_date">Fecha y Hora <RequiredField /></Label>
          <Input
            id="event_date"
            name="event_date"
            type="datetime-local"
            value={formData.date}
            required
          />
        </div>
        <div class="space-y-2">
          <Label for="deadline">Fecha Límite de Inscripción <RequiredField /></Label>
          <Input id="deadline" name="deadline" type="date" required max="" value={formData.deadline} />
          <p class="text-[11px] text-muted-foreground">Debe ser igual o anterior a la fecha del evento.</p>
        </div>
      </div>

      <div class="mt-6 grid gap-6 sm:grid-cols-2">
        <div class="space-y-2">
          <Label for="state">Estado <span class="text-red-500">*</span></Label>
          <select
            id="state"
            name="state"
            required
            class="flex h-11 w-full rounded-lg border border-zinc-200 bg-white px-3 text-sm shadow-sm focus:border-blue-500 focus:ring-2 focus:ring-blue-100 outline-none transition"
          >
            <option value="">Selecciona un estado…</option>
            {ESTADOS.map((estado) => (
              <option value={estado} selected={estado === initialEstado}>{estado}</option>
            ))}
          </select>
        </div>
        <div class="space-y-2">
          <Label for="municipality">Municipio <span class="text-red-500">*</span></Label>
          <select
            id="municipality"
            name="municipality"
            required
            disabled={!initialEstado}
            class="flex h-11 w-full rounded-lg border border-zinc-200 bg-white px-3 text-sm shadow-sm focus:border-blue-500 focus:ring-2 focus:ring-blue-100 outline-none transition disabled:cursor-not-allowed disabled:bg-zinc-100 disabled:text-zinc-400"
          >
            <option value="">Selecciona un municipio…</option>
            {initialMunicipios.map((m) => (
              <option value={m} selected={m === formData.municipality}>{m}</option>
            ))}
          </select>
        </div>
      </div>

      <div class="mt-6 space-y-2">
        <Label for="address">
          Dirección Completa <RequiredField />
        </Label>
        <AddressPicker
          client:only="react"
          name="address"
          initialValue={formData.address}
          placeholder="Busca la dirección (calle, colonia, ciudad)…"
        />
        <p class="text-[11px] text-muted-foreground">
          Empieza a escribir y selecciona una opción. Si quieres ser más exacto, ábrelo en el mapa.
        </p>
      </div>
    </FormSection>

    <!-- ───────── SECCIÓN 3 · ITINERARIO ───────── -->
    <FormSection
      description="Define los puntos clave del evento (largada, hidratación, meta, etc.)"
      title="Itinerario del Evento"
    >
      <div id="itinerary-container">
        <ItineraryEditor
          client:only="react"
          initialItems={isEditing ? (initialSubResources.itinerary as any) : [{ key: 'Salida', time: '08:00', icon: 'map-pin' }]}
        />
      </div>
    </FormSection>

    <!-- ───────── SECCIÓN 4 · DISTANCIAS ───────── -->
    <FormSection
      description="Configura cada distancia con capacidad, superficie y archivo GPX."
      title="Distancias"
    >
      <div slot="actions" class="flex gap-2 items-center">
        <Button type="button" id="add-distance-btn" size="sm" variant="outline">
          + Añadir Distancia
        </Button>
      </div>

      <div class="mb-6">
        <Label class="text-xs text-muted-foreground mb-2 block">
          Añade rápidamente distancias populares:
        </Label>
        <div class="flex flex-wrap gap-2">
          {distanceTypes.map((d) => (
            <Button
              type="button"
              size="sm"
              variant="ghost"
              class="quick-add"
              data-type-id={d.id}
              data-km={d.km}
              data-label={d.name}
            >
              + {d.name}
            </Button>
          ))}
        </div>
      </div>

      <div id="distances-container" class="space-y-6"></div>
    </FormSection>

    <!-- ───────── SECCIÓN 5 · ETAPAS DE PRECIO ───────── -->
    <FormSection
      description="Define los niveles de precios según las fechas (Early bird, Regular, Tardío)"
      title="Etapas de Precio"
    >
      <div slot="actions" class="flex gap-2">
        <Button type="button" id="add-early-bird-btn" size="sm" variant="secondary">
          + Early Bird
        </Button>
        <Button type="button" id="add-price-stage-btn" size="sm" variant="outline">
          + Etapa
        </Button>
      </div>

      <div id="pricing-stages-container" class="space-y-4"></div>

      <p class="text-sm text-muted-foreground text-center py-4" id="no-pricing-msg">
        Sin etapas de precio. Se usará el precio por defecto.
      </p>
    </FormSection>

    <!-- ───────── SECCIÓN 6 · CATEGORÍAS Y PREMIACIONES (siempre presente) ───────── -->
    <FormSection
      description="Define los grupos de edad y premios en metálico por distancia"
      title="Categorías y Premiaciones"
    >
      <div slot="actions" class="flex gap-2">
        <Button type="button" id="add-category-btn" size="sm" variant="outline">
          + Añadir Categoría
        </Button>
      </div>

      <div id="categories-container" class="space-y-4"></div>

      <p class="text-sm text-muted-foreground text-center py-4" id="no-categories-msg">
        No hay categorías todavía.
      </p>
    </FormSection>

    <!-- ───────── SECCIÓN 7 · KIT DEL CORREDOR (siempre presente) ───────── -->
    <FormSection
      description="Artículos que recibirán los participantes (playera, medalla, número, etc.)"
      title="Kit del Corredor"
    >
      <div slot="actions" class="flex gap-2">
        <Button type="button" id="add-kit-btn" size="sm" variant="outline">
          + Añadir Artículo
        </Button>
      </div>

      <div id="kits-container" class="grid gap-4 md:grid-cols-2"></div>

      <p class="text-sm text-muted-foreground text-center py-4" id="no-kits-msg">
        Sin artículos. Agrega al menos uno.
      </p>
    </FormSection>

    <!-- ───────── SECCIÓN 8 · PATROCINADORES (siempre presente) ───────── -->
    <FormSection
      description="Añade a tus patrocinadores y socios del evento"
      title="Patrocinadores"
    >
      <div slot="actions" class="flex gap-2">
        <Button type="button" id="add-sponsor-btn" size="sm" variant="outline">
          + Añadir Sponsor
        </Button>
      </div>

      <div id="sponsors-container" class="grid gap-4 md:grid-cols-2"></div>

      <p class="text-sm text-muted-foreground text-center py-4" id="no-sponsors-msg">
        No hay patrocinadores todavía.
      </p>
    </FormSection>

    <!-- ───────── SECCIÓN 9 · SECCIONES OPCIONALES (toggles) ───────── -->
    <FormSection
      description="Activa las secciones adicionales que necesites para tu evento (no se muestran hasta marcarlas)"
      title="Secciones Opcionales"
    >
      <div class="grid gap-4 md:grid-cols-2 lg:grid-cols-3">
        {OPTIONAL_SECTION_CARDS.map((section) => (
          <div
            class="optional-section-card border rounded-xl p-4 bg-white shadow-sm"
            data-section={section.name}
          >
            <label class="flex items-start gap-3 cursor-pointer select-none">
              <input
                type="checkbox"
                class="optional-section-toggle mt-1"
                data-section={section.name}
              />
              <div class="flex-1">
                <div class="flex items-center gap-2">
                  <span class="text-2xl">{section.icon}</span>
                  <h4 class="font-semibold text-sm">{section.label}</h4>
                </div>
                <p class="text-xs text-muted-foreground mt-1">{section.desc}</p>
              </div>
            </label>
          </div>
        ))}
      </div>
    </FormSection>

    <!-- ───────── SECCIONES OPCIONALES EXPANDIDAS ───────── -->
    <div id="optional-sections-render" class="space-y-8"></div>

    <!-- ───────── FOOTER FIJO ───────── -->
    <div
      class="fixed bottom-0 left-0 right-0 md:left-64 bg-white/90 backdrop-blur-md border-t border-zinc-200 p-4 z-40 shadow-lg"
    >
      <div class="max-w-6xl mx-auto flex items-center justify-end gap-4">
        <Button type="button" variant="ghost" onclick="window.history.back()">Cancelar</Button>
        <Button
          type="submit"
          class="px-8 h-11 rounded-lg shadow-md shadow-blue-500/20 font-semibold"
        >
          {isEditing ? 'Actualizar Evento' : 'Crear Evento'}
        </Button>
      </div>
    </div>
  </form>

  <!-- ──────────────────────── TEMPLATES ──────────────────────── -->
  <DistanceCardTemplate distanceTypes={distanceTypes} surfaces={surfaces} />
  <AwardCardTemplate ageCategories={ageCategories} />
  <SponsorKitTemplates sponsorTiers={sponsorTiers} />
  <PriceStageTemplate />

  <!-- Static catalogs consumed by client bootstrap. -->
  <script
    type="application/json"
    id="kit-icon-catalog"
    set:html={JSON.stringify([
      { value: 'shirt', label: 'Playera', svg: 'M7 4l-3 3v13h16V7l-3-3-5 4z' },
      { value: 'medal', label: 'Medalla', svg: 'M12 8a4 4 0 100 8 4 4 0 000-8zM8 4l4 4 4-4M4 2l4 6M20 2l-4 6' },
      { value: 'trophy', label: 'Trofeo', svg: 'M8 4h8v4a4 4 0 11-8 0V4zM6 4H4v2a3 3 0 003 3M18 4h2v2a3 3 0 01-3 3M10 14h4v3h2v3H8v-3h2v-3z' },
      { value: 'backpack', label: 'Mochila / Bolsa', svg: 'M6 8a2 2 0 012-2h8a2 2 0 012 2v10a2 2 0 01-2 2H8a2 2 0 01-2-2V8zM9 6V4a3 3 0 016 0v2' },
      { value: 'mask', label: 'Buff / Tubular', svg: 'M4 9c0-2 4-3 8-3s8 1 8 3v6c0 2-4 3-8 3s-8-1-8-3V9z' },
      { value: 'bottle', label: 'Termo', svg: 'M9 2h6v3l1 2v13a2 2 0 01-2 2h-4a2 2 0 01-2-2V7l1-2V2zM10 14h4' },
    ])}
  />

  <script define:vars={{ distanceTypes }}>
    window.__DISTANCE_TYPES = distanceTypes;
  </script>
</AppShellLayout>

<script>
  // The form logic lives in src/features/events/editor (unit-tested modules).
  // `mountEventEditor` is idempotent and re-runs on astro:page-load.
  import { mountEventEditor } from '@features/events/editor/mount';

  mountEventEditor();
</script>

<style is:global>
  @keyframes fade-up {
    from { opacity: 0; transform: translateY(8px); }
    to { opacity: 1; transform: translateY(0); }
  }
  .animate-fade-up {
    animation: fade-up 0.25s ease-out forwards;
  }
</style>
