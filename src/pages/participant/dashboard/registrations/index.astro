---
import ParticipantLayout from '@layouts/ParticipantLayout.astro';

const pageTitle = 'Mis Inscripciones';
---

<ParticipantLayout title={pageTitle}>
  <div class="space-y-6">
    <h2 class="text-2xl font-bold">Mis Inscripciones</h2>
    
    <div class="bg-white rounded-xl border shadow-sm overflow-hidden">
      <table class="w-full">
        <thead class="bg-zinc-50 border-b">
          <tr>
            <th class="px-6 py-3 text-left text-xs font-medium text-zinc-500 uppercase">Evento</th>
            <th class="px-6 py-3 text-left text-xs font-medium text-zinc-500 uppercase">Distancia</th>
            <th class="px-6 py-3 text-left text-xs font-medium text-zinc-500 uppercase">Fecha</th>
            <th class="px-6 py-3 text-left text-xs font-medium text-zinc-500 uppercase">Estado</th>
            <th class="px-6 py-3 text-left text-xs font-medium text-zinc-500 uppercase">Acciones</th>
          </tr>
        </thead>
        <tbody class="divide-y">
          <tr>
            <td class="px-6 py-4">
              <div class="font-medium">10K Valencia Marathon</div>
              <div class="text-sm text-zinc-500">Valencia, España</div>
            </td>
            <td class="px-6 py-4">10K</td>
            <td class="px-6 py-4">15 Dic 2024</td>
            <td class="px-6 py-4">
              <span class="px-2 py-1 bg-green-100 text-green-700 text-xs rounded-full">Confirmada</span>
            </td>
            <td class="px-6 py-4">
              <a href="#" class="text-blue-600 hover:underline text-sm">Ver</a>
            </td>
          </tr>
          <tr>
            <td class="px-6 py-4">
              <div class="font-medium">Media Maratón CDMX</div>
              <div class="text-sm text-zinc-500">Ciudad de México</div>
            </td>
            <td class="px-6 py-4">21K</td>
            <td class="px-6 py-4">20 Ene 2025</td>
            <td class="px-6 py-4">
              <span class="px-2 py-1 bg-yellow-100 text-yellow-700 text-xs rounded-full">Pendiente</span>
            </td>
            <td class="px-6 py-4">
              <a href="#" class="text-blue-600 hover:underline text-sm">Ver</a>
            </td>
          </tr>
        </tbody>
      </table>
    </div>
  </div>
</ParticipantLayout>