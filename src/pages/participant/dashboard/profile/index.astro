---
import ParticipantLayout from '@layouts/ParticipantLayout.astro';
import { getAuthUser } from '@/lib/auth';

const user = getAuthUser(Astro);
const pageTitle = 'Mi Perfil';
---

<ParticipantLayout title={pageTitle}>
  <div class="space-y-6">
    <h2 class="text-2xl font-bold">Mi Perfil</h2>
    
    <div class="grid gap-6 md:grid-cols-2">
      <div class="bg-white p-6 rounded-xl border shadow-sm space-y-4">
        <h3 class="text-lg font-semibold">Información Personal</h3>
        
        <div class="grid gap-4">
          <div>
            <label class="text-sm text-zinc-500">Nombre completo</label>
            <div class="font-medium">{user?.first_name} {user?.last_name}</div>
          </div>
          <div>
            <label class="text-sm text-zinc-500">Correo electrónico</label>
            <div class="font-medium">{user?.email}</div>
          </div>
          <div>
            <label class="text-sm text-zinc-500">Rol</label>
            <div class="font-medium uppercase">{user?.role}</div>
          </div>
        </div>
      </div>

      <div class="bg-white p-6 rounded-xl border shadow-sm space-y-4">
        <h3 class="text-lg font-semibold">Editar Información</h3>
        
        <div class="space-y-4">
          <div>
            <label class="text-sm text-zinc-500 block mb-1">Nombre</label>
            <input type="text" value={user?.first_name} class="w-full px-3 py-2 border rounded-lg" />
          </div>
          <div>
            <label class="text-sm text-zinc-500 block mb-1">Apellido</label>
            <input type="text" value={user?.last_name} class="w-full px-3 py-2 border rounded-lg" />
          </div>
          <button class="px-4 py-2 bg-blue-600 text-white rounded-lg">Guardar Cambios</button>
        </div>
      </div>
    </div>
  </div>
</ParticipantLayout>