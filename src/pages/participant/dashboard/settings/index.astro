---
import AppShellLayout from '@layouts/AppShellLayout.astro';

const pageTitle = 'Configuración';
---

<AppShellLayout title={pageTitle}>
  <div class="space-y-6">
    <h2 class="text-2xl font-bold">Configuración</h2>
    
    <div class="bg-white p-6 rounded-xl border shadow-sm space-y-6">
      <div>
        <h3 class="text-lg font-semibold mb-4">Cambiar Contraseña</h3>
        <div class="space-y-4 max-w-md">
          <div>
            <label class="text-sm text-zinc-500 block mb-1">Contraseña actual</label>
            <input type="password" class="w-full px-3 py-2 border rounded-lg" />
          </div>
          <div>
            <label class="text-sm text-zinc-500 block mb-1">Nueva contraseña</label>
            <input type="password" class="w-full px-3 py-2 border rounded-lg" />
          </div>
          <div>
            <label class="text-sm text-zinc-500 block mb-1">Confirmar contraseña</label>
            <input type="password" class="w-full px-3 py-2 border rounded-lg" />
          </div>
          <button class="px-4 py-2 bg-blue-600 text-white rounded-lg">Actualizar Contraseña</button>
        </div>
      </div>

      <hr />

      <div>
        <h3 class="text-lg font-semibold mb-4">Notificaciones</h3>
        <div class="space-y-3">
          <label class="flex items-center gap-3 cursor-pointer">
            <input type="checkbox" checked class="rounded border-zinc-300 text-blue-600" />
            <span>Recibir emails sobre nuevas carreras</span>
          </label>
          <label class="flex items-center gap-3 cursor-pointer">
            <input type="checkbox" checked class="rounded border-zinc-300 text-blue-600" />
            <span>Recordatorios de inscripciones próximas</span>
          </label>
          <label class="flex items-center gap-3 cursor-pointer">
            <input type="checkbox" class="rounded border-zinc-300 text-blue-600" />
            <span>Newsletter semanal</span>
          </label>
        </div>
      </div>

      <hr />

      <div>
        <h3 class="text-lg font-semibold mb-4 text-red-600">Zona Peligrosa</h3>
        <button class="px-4 py-2 border border-red-600 text-red-600 rounded-lg hover:bg-red-50">
          Eliminar mi cuenta
        </button>
      </div>
    </div>
  </div>
</AppShellLayout>