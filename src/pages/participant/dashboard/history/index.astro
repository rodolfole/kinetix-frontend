---
import ParticipantLayout from '@layouts/ParticipantLayout.astro';

const pageTitle = 'Historial de Carreras';
---

<ParticipantLayout title={pageTitle}>
  <div class="space-y-6">
    <h2 class="text-2xl font-bold">Historial de Carreras</h2>
    
    <div class="bg-white rounded-xl border shadow-sm overflow-hidden">
      <table class="w-full">
        <thead class="bg-zinc-50 border-b">
          <tr>
            <th class="px-6 py-3 text-left text-xs font-medium text-zinc-500 uppercase">Evento</th>
            <th class="px-6 py-3 text-left text-xs font-medium text-zinc-500 uppercase">Distancia</th>
            <th class="px-6 py-3 text-left text-xs font-medium text-zinc-500 uppercase">Fecha</th>
            <th class="px-6 py-3 text-left text-xs font-medium text-zinc-500 uppercase">Tiempo</th>
            <th class="px-6 py-3 text-left text-xs font-medium text-zinc-500 uppercase">Posición</th>
          </tr>
        </thead>
        <tbody class="divide-y">
          <tr>
            <td class="px-6 py-4">
              <div class="font-medium">5K Primavera</div>
              <div class="text-sm text-zinc-500">Parque Alameda</div>
            </td>
            <td class="px-6 py-4">5K</td>
            <td class="px-6 py-4">10 Mar 2024</td>
            <td class="px-6 py-4">00:28:45</td>
            <td class="px-6 py-4">
              <span class="text-green-600 font-medium">15/120</span>
            </td>
          </tr>
          <tr>
            <td class="px-6 py-4">
              <div class="font-medium">10K Otoño</div>
              <div class="text-sm text-zinc-500">Centro Histórico</div>
            </td>
            <td class="px-6 py-4">10K</td>
            <td class="px-6 py-4">15 Sep 2024</td>
            <td class="px-6 py-4">01:02:30</td>
            <td class="px-6 py-4">
              <span class="text-blue-600 font-medium">45/200</span>
            </td>
          </tr>
        </tbody>
      </table>
    </div>
  </div>
</ParticipantLayout>