---
import AppShellLayout from '@layouts/AppShellLayout.astro';
import { dashboard } from '@features/dashboard/actions/dashboard.action';

// Real data: `GET /registrations/participant/{id}` (§T6).
const overviewRes = await Astro.callAction(dashboard.getParticipantOverview, {});
const overview = overviewRes.data ?? null;
const loadError = overviewRes.error?.message ?? null;

const stats = overview?.stats ?? { total: 0, confirmed: 0, pending: 0 };
const upcoming = (overview?.upcoming ?? []).slice(0, 5);
const isEmpty = stats.total === 0;

const formatDate = (value: string) =>
  value
    ? new Date(value).toLocaleDateString('es-MX', { day: 'numeric', month: 'long', year: 'numeric' })
    : 'Fecha por confirmar';

const pageTitle = 'Mi Dashboard';
---

<AppShellLayout title={pageTitle}>
  <div class="space-y-6">
    {loadError && (
      <div class="rounded-xl border border-red-200 bg-red-50 p-4 text-sm text-red-700">
        No pudimos cargar tus inscripciones: {loadError}
      </div>
    )}

    <div class="grid gap-4 md:grid-cols-3">
      <div class="bg-white p-6 rounded-xl border shadow-sm">
        <div class="text-sm text-muted-foreground">Mis Inscripciones</div>
        <div class="text-3xl font-bold">{stats.total}</div>
      </div>
      <div class="bg-white p-6 rounded-xl border shadow-sm">
        <div class="text-sm text-muted-foreground">Confirmadas</div>
        <div class="text-3xl font-bold">{stats.confirmed}</div>
      </div>
      <div class="bg-white p-6 rounded-xl border shadow-sm">
        <div class="text-sm text-muted-foreground">Pendientes</div>
        <div class="text-3xl font-bold">{stats.pending}</div>
      </div>
    </div>

    <div class="bg-white p-6 rounded-xl border shadow-sm">
      <h3 class="text-lg font-semibold mb-4">Próximas Inscripciones</h3>

      {isEmpty ? (
        <div class="text-center py-8">
          <p class="text-sm text-muted-foreground">Todavía no tienes inscripciones registradas.</p>
          <a href="/events" class="mt-3 inline-block text-sm font-medium text-blue-600 hover:underline">
            Explorar eventos
          </a>
        </div>
      ) : upcoming.length === 0 ? (
        <p class="text-sm text-muted-foreground">
          No tienes carreras próximas. Revisa tu historial para ver las anteriores.
        </p>
      ) : (
        <div class="space-y-4">
          {upcoming.map((registration, index) => (
            <div class:list={['flex items-center justify-between', index < upcoming.length - 1 && 'border-b pb-4']}>
              <div>
                <div class="font-medium">{registration.eventName || 'Evento'}</div>
                <div class="text-sm text-muted-foreground">{formatDate(registration.eventDate)}</div>
              </div>
              <div class="text-right">
                <div class="text-blue-600 font-medium uppercase">{registration.status}</div>
                {registration.bibNumber && (
                  <div class="text-xs text-muted-foreground">Dorsal {registration.bibNumber}</div>
                )}
              </div>
            </div>
          ))}
        </div>
      )}
    </div>
  </div>
</AppShellLayout>
