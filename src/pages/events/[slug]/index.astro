---
import { actions } from 'astro:actions';
import { EventHero, EventDescription, EventPricing, EventDistances, EventCTA, EventItineraryTimeline, EventRunnerKit } from '@features/events/components';
import type { BaseEvent } from '@features/events/types/event.type';
import type { RouteData } from '@features/events/types/route.type';
import MainLayout from '@layouts/MainLayout.astro';

const { slug } = Astro.params;

const result = await Astro.callAction(actions.event.getBySlug, { slug: slug as string });
const event = (result.data as unknown as BaseEvent) ?? null;

if (!event || !event.id) {
  return Astro.redirect('/');
}

// Fetch routes for this event
const routesResult = await Astro.callAction(actions.event.getRoutes, { eventId: event.id });
const routes = (routesResult.data as unknown as RouteData[]) ?? [];
---

<MainLayout title={event.name} description={event.shortDescription}>
  <EventHero event={event} />
  <EventDescription event={event} routes={routes} />
  <EventItineraryTimeline event={event} />
  <EventRunnerKit event={event} />
  <EventPricing event={event} />
  <EventDistances event={event} />
  <EventCTA event={event} />
</MainLayout>