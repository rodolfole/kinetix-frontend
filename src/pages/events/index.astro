---
import MainLayout from '@layouts/MainLayout.astro';
import { actions } from 'astro:actions';
import type { BaseEvent } from '@features/events/types/event.type';

const result = await Astro.callAction(actions.home.getEvents, {});
const events = (result.data as unknown as BaseEvent[]) ?? [];

const sorted = [...events].sort((a, b) => new Date(a.date).getTime() - new Date(b.date).getTime());

const fmt = (d: string) =>
  new Date(d).toLocaleDateString('es-MX', {
    weekday: 'short',
    day: '2-digit',
    month: 'short',
    year: 'numeric',
  });
---

<MainLayout title="Eventos" description="Todas las carreras en Kinetix">
  <main class="pt-24 pb-20 px-4 md:px-6 min-h-screen bg-zinc-50/50">
    <div class="max-w-5xl mx-auto">
      <header class="mb-10 text-center">
        <h1 class="text-3xl md:text-5xl font-black tracking-tight">Eventos</h1>
        <p class="mt-3 text-muted-foreground">{events.length} carreras disponibles en Kinetix.</p>
      </header>

      {events.length === 0 && (
        <p class="text-center text-muted-foreground">Aún no hay carreras para mostrar.</p>
      )}

      <ul class="grid gap-4 md:grid-cols-2">
        {sorted.map((event) => (
          <li>
            <a
              href={`/events/${event.slug}`}
              class="block rounded-xl border bg-white p-5 hover:border-blue-500 hover:shadow-sm transition"
            >
              <h2 class="text-lg font-semibold">{event.name}</h2>
              <p class="text-sm text-muted-foreground mt-1">{event.shortDescription}</p>
              <div class="mt-3 text-xs text-muted-foreground">
                <span>{fmt(event.date)}</span>
                <span class="mx-2">·</span>
                <span>{event.location.municipality}, {event.location.state}</span>
              </div>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </main>
</MainLayout>