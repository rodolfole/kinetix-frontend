---
import Layout from '@layouts/AppShellLayout.astro';
---
<Layout title="Admin · Kinetix">
  <div class="space-y-6">
    <header>
      <h1 class="text-2xl font-black text-zinc-900">Admin</h1>
      <p class="text-sm text-zinc-500 mt-1">Configuración global y payouts a organizers.</p>
    </header>

    <nav class="grid grid-cols-1 sm:grid-cols-2 gap-4 max-w-2xl">
      <a href="/admin/settings" class="rounded-xl border border-zinc-200 bg-white p-5 hover:border-blue-400 transition">
        <h2 class="text-base font-semibold text-zinc-900">Configuración</h2>
        <p class="text-sm text-zinc-500 mt-1">Comisión de la plataforma.</p>
      </a>
      <a href="/admin/payments" class="rounded-xl border border-zinc-200 bg-white p-5 hover:border-blue-400 transition">
        <h2 class="text-base font-semibold text-zinc-900">Payouts</h2>
        <p class="text-sm text-zinc-500 mt-1">Pagos pendientes a organizers.</p>
      </a>
    </nav>
  </div>
</Layout>
